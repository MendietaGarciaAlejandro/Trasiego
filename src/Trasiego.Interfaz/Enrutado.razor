@implements IDisposable
@inject ClienteDeTrasiego trasiego

@if (comprobando)
{
    <p class="vacio portada">Abriendo Trasiego...</p>
}
else if (!trasiego.HaEntrado)
{
    <Acceso />
}
else
{
    <Router AppAssembly="@GetType().Assembly">
        <Found Context="ruta">
            <RouteView RouteData="@ruta" DefaultLayout="@typeof(Marco)" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Marco)">
                <p class="vacio">Esa pantalla no existe.</p>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    private bool comprobando = true;

    protected override async Task OnInitializedAsync()
    {
        trasiego.SesionCambiada += Repintar;

        // Al abrir se prueba a seguir donde se dejo: si la renovacion sigue valiendo, su
        // cookie viaja sola y no hay que volver a teclear nada.
        await trasiego.Retomar();
        comprobando = false;
    }

    public void Dispose() => trasiego.SesionCambiada -= Repintar;

    private void Repintar() => InvokeAsync(StateHasChanged);
}
