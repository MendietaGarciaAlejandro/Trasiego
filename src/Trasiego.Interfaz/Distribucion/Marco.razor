@inherits LayoutComponentBase
@inject ClienteDeTrasiego trasiego
@inject NavigationManager navegacion

<div class="marco">
    <nav class="lateral">
        <div class="marca">Trasiego</div>

        <NavLink href="" Match="NavLinkMatch.All">Kardex</NavLink>
        <NavLink href="articulos">Articulos</NavLink>
        <NavLink href="documentos">Documentos</NavLink>
        <NavLink href="almacenes">Almacenes</NavLink>

        @* Lo que un operario no puede hacer tampoco se le enseña. Quien manda de verdad es
           la Api, que responde 403; esto solo evita ofrecer botones que no van a funcionar. *@
        @if (trasiego.EsResponsable)
        {
            <div class="separador">Cierre</div>
            <NavLink href="valoracion">Valoracion</NavLink>
            <NavLink href="cierres">Cierres</NavLink>
            <NavLink href="recalculo">Recalculo</NavLink>
        }

        <div class="pie">
            <div class="quien">@trasiego.Nombre</div>
            <button class="salir" @onclick="Salir">Salir</button>
        </div>
    </nav>

    <main class="contenido">
        @Body
    </main>
</div>

@code {
    // Vuelve al kardex antes de cerrar, para que al entrar otra vez no se caiga en una
    // pantalla que quiza el siguiente no pueda ver.
    private async Task Salir()
    {
        navegacion.NavigateTo("");
        await trasiego.Salir();
    }
}
